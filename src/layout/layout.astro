---
import "../styles/styles.css";
import { gamesMap, defaultGames, MORE_GAMES_COUNT } from "../data/game-seo";

interface Props {
  slug?: string;
  pageTitle?: string;
  isHome?: boolean;
}

const { slug, pageTitle, isHome } = Astro.props;
const siteUrl = "https://unblocked-games.vercel.app";

// SEO data — `slug` is the page slug; display name comes from the registry
const seo = slug ? gamesMap[slug] : undefined;
const Game = seo?.title;
const isFlash = seo?.isFlash ?? false;
// ponytail: static date keeps dateModified stable across builds
const dateModified = "2026-06-10";
const jsonLD = (data: unknown) => JSON.stringify(data).replace(/</g, "\\u003c");

// Title
const gameTitle = Game
  ? `Play ${Game} Unblocked on Chromebook - No Flash Required (2026)`
  : pageTitle || "Superfun Games - Unblocked Games for School Chromebook";

// Description
const homeDescription = "Play free unblocked games on your school Chromebook - Happy Wheels, Plants vs Zombies, Run 3 and more. No downloads, works in your browser.";

const gameDescription = isHome
  ? homeDescription
  : seo?.description ||
    `Play ${Game} unblocked on your school Chromebook. No Flash plugin or download needed - runs directly in your browser. Fully working 2026 version of this classic game.`;

// Image & other SEO fields — ponytail: webp covers beat SVG for og:image validators
const gameImage = isHome
  ? "/images/happywheelscover.webp"
  : seo?.image || "/images/happywheelscover.webp";

const gameGenre = seo?.genre || "Game";
const gameYear = seo?.year || "";

// URL
const pageUrl = slug ? `${siteUrl}/games/${slug}` : siteUrl;

// More Games cross-linking — curated list of popular games
const moreGames = defaultGames.slice(0, MORE_GAMES_COUNT).filter((s) => s !== slug); // exclude current game
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{gameTitle}</title>
    <meta name="description" content={gameDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={pageUrl} />

    {
      isHome && (
        <meta name="google-site-verification" content="NBlOMVSv6plhaf7kQsHx4aXHHlFlw1q8N0s44BOlVyk" />
      )
    }

    {
      isFlash && (
        <link rel="preload" href="/ruffle/ruffle.js" as="script" crossorigin="anonymous" />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={gameTitle} />
    <meta property="og:description" content={gameDescription} />
    <meta property="og:image" content={`${siteUrl}${gameImage}`} />
    <meta property="og:image:width" content="300" />
    <meta property="og:image:height" content="200" />
    <meta property="og:image:alt" content={Game ? `${Game} - play unblocked online` : "Superfun Games - unblocked games"} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Superfun Games" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={gameTitle} />
    <meta name="twitter:description" content={gameDescription} />
    <meta name="twitter:image" content={`${siteUrl}${gameImage}`} />
    <meta name="twitter:image:alt" content={Game ? `${Game} - play unblocked online` : "Superfun Games - unblocked games"} />

    {
      Game && !isHome ? (
        <>
          <!-- JSON-LD BreadcrumbList -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "BreadcrumbList",
              itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
                { "@type": "ListItem", position: 2, name: Game, item: pageUrl },
              ],
            })}
          />
          <!-- JSON-LD VideoGame -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "VideoGame",
              name: Game,
              description: gameDescription,
              image: `${siteUrl}${gameImage}`,
              url: pageUrl,
              genre: gameGenre,
              gamePlatform: "Web Browser",
              operatingSystem: "All (including Chrome OS / Chromebook)",
              browserRequirements: "Works in all modern browsers including Chrome on Chromebook",
              author: { "@type": "Organization", name: "Superfun Games" },
              offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "USD",
                availability: "https://schema.org/InStock",
              },
              applicationCategory: "GameApplication",
              dateModified: dateModified,
              ...(gameYear ? { datePublished: gameYear } : {}),
              ...(isFlash ? { requirements: "No Flash plugin needed - runs via Ruffle emulator" } : {}),
            })}
          />
        </>
      ) : null
    }

    {
      isHome ? (
        <>
          <!-- JSON-LD WebSite -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "WebSite",
              name: "Superfun Games",
              url: siteUrl,
              description: homeDescription,
            })}
          />
          <!-- JSON-LD CollectionPage -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "CollectionPage",
              name: "Unblocked Games Collection",
              description:
                "A curated collection of classic Flash games and browser games that work without Flash Player. All games run directly in your browser using modern emulation.",
              url: siteUrl,
              about: { "@type": "Thing", name: "Classic Browser Games" },
            })}
          />
          <!-- JSON-LD Organization -->
          <script
            is:inline
            type="application/ld+json"
            set:html={jsonLD({
              "@context": "https://schema.org",
              "@type": "Organization",
              name: "Superfun Games",
              url: siteUrl,
              logo: `${siteUrl}/images/games_logo_light.svg`,
              description: homeDescription,
              foundingDate: "2024",
              sameAs: ["https://github.com/noahgsolomon/unblocked-games"],
            })}
          />
        </>
      ) : null
    }

    <link rel="preconnect" href="https://rybbit.theoneand33.dev" />
    <script is:inline defer src="https://rybbit.theoneand33.dev/api/script.js" data-site-id="1ab7f49a0bc5"></script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-component-ui.js" type="module" is:inline></script>
  </head>
  <body>
    <nav class="flex items-center justify-between">
      <a href="/" data-astro-prefetch>
        <img
          src="/images/games_logo_light.svg"
          alt="Superfun Games - Unblocked Games Home"
          width="300"
          class="m-5"
        />
      </a>
      <div class="mr-5 flex gap-4 text-sm items-center">
        <a href="/" class="hover:text-black text-gray-800 transition-colors">Home</a>
        <a href="/dmca" class="hover:text-black text-gray-800 transition-colors">DMCA</a>
        <pagefind-searchbox></pagefind-searchbox>
      </div>
    </nav>

    <main>
      {Game && !isHome && (
        <div class="mx-auto max-w-[1200px] px-6 pt-2">
          <h1 data-pagefind-body class="text-xl font-bold">
            Play {Game} Unblocked on Chromebook
          </h1>
          <div class="py-2">
            <p class="text-sm text-gray-500 mb-1 line-clamp-3">
              {gameDescription}
            </p>
            <p class="text-xs text-gray-400 font-medium">
              ✓ {isFlash
                ? "No Flash plugin required — works on school Chromebooks via Ruffle emulator"
                : "Works on school Chromebooks — no downloads needed"}
            </p>
          </div>
        </div>
      )}
      <slot />
    </main>

    {Game && !isHome && (
      <div class="mx-auto max-w-[1200px] px-6 pt-2">
        <!-- More Games cross-linking (dynamically generated) -->
        <nav aria-label="More unblocked games" class="border-t border-gray-200 mt-4 py-4">
          <h2 class="text-sm font-semibold mb-2 text-gray-700">More Unblocked Games</h2>
          <div class="flex flex-wrap gap-2 text-xs">
            {moreGames.map((s) => (
              <a href={`/games/${s}`} class="text-blue-600 hover:underline">{gamesMap[s].title}</a>
            ))}
          </div>
        </nav>
      </div>
    )}

    <footer>
      <p class="ml-6 mb-4">
        All games sourced from <a
          class="hover:underline underline-offset-2 text-blue-600"
          href="https://archive.org">Internet Archive</a
        >
      </p>
    </footer>
  </body>
</html>
