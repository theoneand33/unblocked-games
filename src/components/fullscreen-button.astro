---
interface Props {
  kind: "flash" | "html5";
  gamePath?: string;
  title: string;
}

const { kind, gamePath = "", title } = Astro.props;
---

<div class="flex justify-center pt-4">
  <button
    type="button"
    id="fullscreen-btn"
    data-kind={kind}
    data-path={gamePath}
    data-title={title}
    aria-label={`Open ${title} in fullscreen mode`}
    class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded transition-colors"
  >
    Fullscreen
  </button>
</div>

<script>
  import { openFullscreen } from "../lib/fullscreen";

  const btn = document.getElementById("fullscreen-btn");
  btn?.addEventListener("click", () => {
    const kind = btn.getAttribute("data-kind") === "html5" ? "html5" : "flash";
    openFullscreen(
      kind,
      btn.getAttribute("data-path") || "",
      btn.getAttribute("data-title") || "",
    );
  });
</script>