---
interface Props {
  kind: "flash" | "html5";
  gamePath?: string;
  title?: string;
}

const { kind, gamePath = "", title = "Game" } = Astro.props;
---

<div class="flex justify-center pt-4">
  <button
    type="button"
    id="fullscreen-btn"
    data-kind={kind}
    data-path={gamePath}
    data-title={title}
    class="px-4 py-2 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded transition-colors"
  >
    ⛶ Fullscreen
  </button>
</div>

<script is:inline>
  (function () {
    var btn = document.getElementById("fullscreen-btn");
    if (!btn) return;

    btn.addEventListener("click", function () {
      var kind = btn.getAttribute("data-kind");
      var path = btn.getAttribute("data-path") || "";
      var title = btn.getAttribute("data-title") || "Game";

      var html;
      if (kind === "html5") {
        html = [
          "<!DOCTYPE html><html><head>",
          '<meta charset="utf-8"><title>' + title + "</title>",
          '<base href="/games/run3/">',
          "<style>html,body{margin:0;height:100%;background:#000}#openfl-content{position:fixed;inset:0}</style>",
          '</head><body><div id="openfl-content"></div>',
          '<script src="/games/run3/Run3.js"><' + "/script>",
          "<script>",
          "(function(){",
          "window.addEventListener('touchmove',function(e){e.preventDefault();},{passive:false});",
          "function ready(){",
          "var el=document.getElementById('openfl-content');",
          "if(el&&typeof lime!=='undefined'&&lime.embed){lime.embed('Run3','openfl-content',800,600,{parameters:{}});}",
          "else{setTimeout(ready,200);}",
          "}",
          "ready();",
          "})();",
          "<" + "/script>",
          "</body></html>",
        ].join("");
      } else {
        html = [
          "<!DOCTYPE html><html><head>",
          '<meta charset="utf-8"><title>' + title + "</title>",
          "<style>html,body{margin:0;padding:0;height:100%;overflow:hidden;background:#000}#wrap{position:fixed;inset:0;display:flex;align-items:center;justify-content:center}</style>",
          '</head><body><div id="wrap"></div>',
          '<script src="/ruffle/ruffle.js"><' + "/script>",
          "<script>",
          "(function(){",
          "var wrap=document.getElementById('wrap');",
          "function init(){",
          "var r=window.RufflePlayer&&window.RufflePlayer.newest?window.RufflePlayer.newest():null;",
          "if(!r||!r.createPlayer){return setTimeout(init,200);}",
          "var p=r.createPlayer();",
          "wrap.appendChild(p);",
          "function size(){",
          "var w=innerWidth,h=innerHeight;",
          "var pw=w,ph=w*3/4;",
          "if(ph>h){ph=h;pw=h*4/3;}",
          "p.style.width=pw+'px';p.style.height=ph+'px';",
          "}",
          "size();",
          "addEventListener('resize',size);",
          "p.load('" + path + "');",
          "}",
          "init();",
          "})();",
          "<" + "/script>",
          "</body></html>",
        ].join("");
      }

      var win = window.open("", "_blank");
      if (!win) return;
      win.document.write(html);
      win.document.close();
    });
  })();
</script>
