---
import Layout from "../../layout/layout.astro";
import FullscreenButton from "../../components/fullscreen-button.astro";
---

<Layout slug="run-3">
  <FullscreenButton kind="html5" title="Run 3" />
  <base href="/games/run3/" />
  <div id="run3-wrapper" class="text-center h-[96vh] w-full">
    <div
      id="openfl-content"
      class="bg-black w-full h-full"
    ></div>
  </div>

  <script src="/games/run3/Run3.js" is:inline></script>
  <script>
    import { embedRun3 } from "../../lib/fullscreen";
    embedRun3("openfl-content");
  </script>
</Layout>
